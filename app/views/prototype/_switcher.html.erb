<%# PROTOTYPE: floating variant switcher. Never rendered in production. %>
<%# Optional locals: scenarios (key => label) and scenario, for a scenario picker; anything in content_for(:prototype_switcher) is appended. %>
<% if Rails.env.local? %>
  <% scenarios = local_assigns.fetch(:scenarios, {}) %>
  <nav class="prototype-switcher" data-controller="prototype-switcher"
       data-prototype-switcher-variants-value="<%= variants.keys.to_json %>"
       data-prototype-switcher-current-value="<%= current %>"
       data-prototype-switcher-scenarios-value="<%= scenarios.keys.to_json %>"
       data-prototype-switcher-scenario-value="<%= local_assigns[:scenario] %>"
       data-action="keydown@window->prototype-switcher#key">
    <button type="button" data-action="prototype-switcher#previous" aria-label="Previous variant">←</button>
    <span><%= current %> (<%= variants[current] %>)</span>
    <button type="button" data-action="prototype-switcher#next" aria-label="Next variant">→</button>
    <% if scenarios.any? %>
      <select aria-label="Scenario (↑ ↓)" data-action="prototype-switcher#pick">
        <%= options_for_select scenarios.invert, local_assigns[:scenario] %>
      </select>
    <% end %>
    <%= yield :prototype_switcher %>
  </nav>
<% end %>
